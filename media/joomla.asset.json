{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_servicedeskplus",
  "version": "1.34.0",
  "description": "ServiceDesk Plus portal assets",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "com_servicedeskplus.submit-once",
      "type": "script",
      "uri": "com_servicedeskplus/submit-once.js",
      "attributes": {
        "defer": true
      },
      "version": "auto"
    },
    {
      "name": "com_servicedeskplus.preview",
      "type": "script",
      "uri": "com_servicedeskplus/preview.js",
      "attributes": {
        "defer": true
      },
      "version": "auto"
    },
    {
      "name": "com_servicedeskplus.filters",
      "type": "script",
      "uri": "com_servicedeskplus/filters.js",
      "attributes": {
        "defer": true
      },
      "version": "auto"
    },
    {
      "name": "com_servicedeskplus.refresh",
      "type": "script",
      "uri": "com_servicedeskplus/refresh.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      },
      "version": "auto"
    },
    {
      "name": "com_servicedeskplus.portal",
      "type": "style",
      "uri": "com_servicedeskplus/portal.css",
      "version": "auto"
    },
    {
      "name": "com_servicedeskplus.admin",
      "type": "style",
      "uri": "com_servicedeskplus/admin.css",
      "version": "auto"
    }
  ]
}
