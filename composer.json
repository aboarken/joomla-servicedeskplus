{
    "name": "aboarken/joomla-servicedeskplus",
    "description": "Development tools for com_servicedeskplus (tests only: nothing here is installed in Joomla)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "SdpPortal\\Component\\ServiceDeskPlus\\Administrator\\": "administrator/src/",
            "SdpPortal\\Component\\ServiceDeskPlus\\Site\\": "site/src/",
            "SdpPortal\\Component\\ServiceDeskPlus\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
